        for action_id, editor in self._editors.items():
            editor.setKeySequence(QKeySequence(_DEFAULT_SHORTCUTS[action_id]))

    def get_shortcuts(self) -> dict:
        return {aid: self._editors[aid].keySequence().toString()
                for aid in self._editors}


_HL_ERROR           = re.compile(r'\berror\b', re.IGNORECASE)
_HL_WARN            = re.compile(r'\bwarning\b', re.IGNORECASE)
_HL_NOTE            = re.compile(r'\bnote\b', re.IGNORECASE)
_HL_EXIT            = re.compile(r'^\[exited (\d+)\]')
_HL_UNINSTALL_FAIL  = re.compile(r'^(Failed:\s+[1-9]|Could not delete\b)', re.IGNORECASE)

_OUT_COLOR_OK    = '#90ee90'
_OUT_COLOR_ERROR = '#ff6b6b'
_OUT_COLOR_WARN  = '#f0c060'
_OUT_COLOR_NOTE  = '#87ceeb'


def _append_highlighted(out, text, buf):
    combined = buf[0] + text
    parts = combined.split('\n')
    if combined.endswith('\n'):
        buf[0] = ''
        lines = parts[:-1]
    else:
        buf[0] = parts[-1]
        lines = parts[:-1]
    cursor = out.textCursor()
    cursor.movePosition(QTextCursor.End)
    for line in lines:
        fmt = QTextCharFormat()
        m = _HL_EXIT.match(line.strip())
        if m:
            fmt.setForeground(QColor(_OUT_COLOR_OK if m.group(1) == '0' else _OUT_COLOR_ERROR))
        elif _HL_UNINSTALL_FAIL.match(line.strip()) or _HL_ERROR.search(line) or 'FAILED' in line:
            fmt.setForeground(QColor(_OUT_COLOR_ERROR))
        elif _HL_WARN.search(line):
            fmt.setForeground(QColor(_OUT_COLOR_WARN))
        elif _HL_NOTE.search(line):
            fmt.setForeground(QColor(_OUT_COLOR_NOTE))
        cursor.insertText(line + '\n', fmt)
    out.setTextCursor(cursor)
    out.ensureCursorVisible()


class MesonSetupDialog(QDialog):
    def __init__(self, parent: QWidget, args: list, font_size: int = _DEFAULT_OUTPUT_FONT_SIZE):
        super().__init__(parent)
        self.setWindowTitle('meson setup')
        self.resize(720, 480)
        layout = QVBoxLayout(self)
        self._out = QTextEdit()
        self._out.setReadOnly(True)
        self._out.setFont(QFont('monospace', font_size))
        layout.addWidget(self._out)
        self._btn = QPushButton('Close')
        self._btn.setEnabled(False)
        self._btn.clicked.connect(self.accept)
        layout.addWidget(self._btn)
        self._proc = QProcess(self)
        self._proc.setProcessChannelMode(QProcess.MergedChannels)
        self._proc.readyRead.connect(
            lambda: self._append(bytes(self._proc.readAll()).decode(errors='replace'))
        )
        self._proc.finished.connect(self._on_finished)
        self._line_buf = ['']
        self.exit_code = None
        self._proc.start('meson', args)

    def _append(self, text: str):
        _append_highlighted(self._out, text, self._line_buf)

    def _on_finished(self, code: int, _status):
        self.exit_code = code
        self._append(f'\n[exited {code}]\n')
        self._btn.setEnabled(True)

    def closeEvent(self, event):
        if self._proc.state() != QProcess.NotRunning:
            self._proc.kill()
            self._proc.waitForFinished(2000)
        super().closeEvent(event)


class TranslationsDialog(QDialog):
    def __init__(self, parent, source_dir: str, font_size: int = _DEFAULT_OUTPUT_FONT_SIZE):
        super().__init__(parent)
        self._source_dir = Path(source_dir)
        self._po_dir = self._source_dir / 'po'
        self._queue = []
        self._line_buf = ['']
        self.setWindowTitle('Translations')
        self.resize(720, 480)
        layout = QVBoxLayout(self)
        self._out = QTextEdit()
        self._out.setReadOnly(True)
        self._out.setFont(QFont('monospace', font_size))
        layout.addWidget(self._out)
        btns = QHBoxLayout()
        self._pot_btn = QPushButton('Generate .pot')
        self._pot_btn.clicked.connect(self._generate_pot)
        self._update_btn = QPushButton('Update .po files')
        self._update_btn.clicked.connect(self._update_po)
        self._close_btn = QPushButton('Close')
        self._close_btn.clicked.connect(self.accept)
        btns.addWidget(self._pot_btn)
        btns.addWidget(self._update_btn)
        btns.addStretch()
        btns.addWidget(self._close_btn)
        layout.addLayout(btns)
        self._proc = QProcess(self)
        self._proc.setProcessChannelMode(QProcess.MergedChannels)
        self._proc.readyRead.connect(
            lambda: self._append(bytes(self._proc.readAll()).decode(errors='replace'))
        )
        self._proc.finished.connect(self._on_finished)

    def _append(self, text: str):
        _append_highlighted(self._out, text, self._line_buf)

    def _set_running(self, running: bool):
        self._pot_btn.setEnabled(not running)
        self._update_btn.setEnabled(not running)
        self._close_btn.setEnabled(not running)

    def _run_next(self):
        if not self._queue:
            self._set_running(False)
            return
        prog, args, cwd = self._queue.pop(0)
        self._append(f'$ {prog} {" ".join(args)}\n')
        self._proc.setWorkingDirectory(str(cwd))
        self._proc.start(prog, args)

    def _on_finished(self, code: int, _status):
        self._append(f'[exited {code}]\n\n')
        if code != 0:
            self._queue.clear()
            self._set_running(False)
        else:
            self._run_next()

    def _generate_pot(self):
        potfiles = self._po_dir / 'POTFILES'
        if not potfiles.exists():
            self._append(f'No po/POTFILES found in {self._source_dir}\n')
            return
        sources = [line.strip() for line in potfiles.read_text().splitlines() if line.strip()]
        pot_out = self._po_dir / f'{self._source_dir.name}.pot'
        self._queue = [(
            'xgettext',
            ['--language=Python', '--keyword=_', '--add-comments',
             f'--output={pot_out}'] + sources,
            self._source_dir,
        )]
        self._set_running(True)
        self._run_next()

    def _update_po(self):
        pot = next(self._po_dir.glob('*.pot'), None)
        if pot is None:
            self._append('No .pot file found — generate it first.\n')
            return
        po_files = sorted(self._po_dir.glob('*.po'))
        if not po_files:
            self._append('No .po files found.\n')
            return
        self._queue = [
            ('msgmerge', ['--update', str(po), str(pot)], self._source_dir)
            for po in po_files
        ]
        self._set_running(True)
        self._run_next()

    def closeEvent(self, event):
        if self._proc.state() != QProcess.NotRunning:
            self._proc.kill()
            self._proc.waitForFinished(2000)
        super().closeEvent(event)


class CompilePanel(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self._builddir = None
        layout = QVBoxLayout(self)

        form = QHBoxLayout()
        form.addWidget(QLabel('Jobs:'))
        self._jobs = QSpinBox()
        self._jobs.setRange(0, 256)
        self._jobs.setValue(0)
        self._jobs.setSpecialValueText('default')
        self._jobs.setToolTip('0 = use meson default')
        form.addWidget(self._jobs)
        form.addSpacing(12)
        self._verbose = QCheckBox('Verbose')
        form.addWidget(self._verbose)
        self._clean = QCheckBox('Clean')
        form.addWidget(self._clean)
        form.addSpacing(12)
        form.addWidget(QLabel('Target:'))
        self._target = QLineEdit()
        self._target.setPlaceholderText('(all)')
        form.addWidget(self._target)
        form.addStretch()
        layout.addLayout(form)

        self._out = QTextEdit()
        self._out.setReadOnly(True)
        self._out.setFont(QFont('monospace', _DEFAULT_OUTPUT_FONT_SIZE))
        layout.addWidget(self._out)

        self._run_btn = QPushButton('Run')
        self._run_btn.setEnabled(False)
        self._run_btn.clicked.connect(self._run)
        layout.addWidget(self._run_btn, alignment=Qt.AlignRight)

        self._proc = QProcess(self)
        self._proc.setProcessChannelMode(QProcess.MergedChannels)
        self._proc.readyRead.connect(
            lambda: self._append(bytes(self._proc.readAll()).decode(errors='replace'))
        )
        self._proc.finished.connect(self._on_finished)
        self._line_buf = ['']


    def set_builddir(self, builddir):
        self._builddir = builddir
        self._run_btn.setEnabled(builddir is not None)

    def _run(self):
        self._out.clear()
        self._line_buf[0] = ''
        self._run_btn.setEnabled(False)
        args = ['compile', '-C', str(self._builddir)]
        if self._jobs.value() > 0:
            args += ['-j', str(self._jobs.value())]
        if self._verbose.isChecked():
            args.append('--verbose')
        if self._clean.isChecked():
            args.append('--clean')
        if self._target.text().strip():
            args.append(self._target.text().strip())
        self._proc.start('meson', args)

    def _append(self, text: str):
        _append_highlighted(self._out, text, self._line_buf)

    def _on_finished(self, code: int, _status):
        self._append(f'\n[exited {code}]\n')
        self._run_btn.setEnabled(True)

    def closeEvent(self, event):
        if self._proc.state() != QProcess.NotRunning:
            self._proc.kill()
            self._proc.waitForFinished(2000)
        super().closeEvent(event)


