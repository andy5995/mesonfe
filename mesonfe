            data = (builddir / 'meson-info' / 'meson-info.json').read_text()
            info = json.loads(data)
        except (OSError, json.JSONDecodeError):
            pass
        source_dir = info.get('directories', {}).get('source', '')
        self._source_path = Path(source_dir) if source_dir else None

        dirs: dict = {}
        for f in build_files:
            p = Path(f)
            if self._source_path:
                try:
                    rel = p.relative_to(self._source_path)
                except ValueError:
                    rel = p
            else:
                rel = p
            parts = rel.parts
            node = dirs
            for part in parts[:-1]:
                node = node.setdefault(part, {})
            node.setdefault('__files__', []).append((parts[-1] if parts else str(p), str(p)))

        def _populate(parent_item, subtree):
            for name, full_path in sorted(subtree.get('__files__', [])):
                item = QTreeWidgetItem(parent_item, [name])
                item.setData(0, Qt.UserRole, full_path)
            for key in sorted(k for k in subtree if k != '__files__'):
                dir_item = QTreeWidgetItem(parent_item, [key])
                _populate(dir_item, subtree[key])

        _populate(self._tree.invisibleRootItem(), dirs)
        self._tree.expandAll()

    def _view_file(self, item, _column):
        path = item.data(0, Qt.UserRole)
        if path:
            dlg = BuildFileViewer(path, self._source_path, self)
            dlg.exec_()

