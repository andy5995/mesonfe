            lambda: self._append(bytes(self._proc.readAll()).decode(errors='replace'))
        )
        self._proc.finished.connect(self._on_finished)
        self._line_buf = ['']

    def set_project_dir(self, path, force: bool = False):
        if path:
            self._src_dir = str(path)
            if force or not self._src_edit.text():
                self._src_edit.setText(self._src_dir)
                self._auto_load_rc(Path(path))

    def _browse_src(self):
        start = self._src_edit.text() or ''
        path = QFileDialog.getExistingDirectory(self, 'Select Source Directory', start)
        if path:
            self._src_edit.setText(path)

    def _browse_bld(self):
        start = self._src_edit.text() or ''
        path = QFileDialog.getExistingDirectory(self, 'Select Build Directory', start)
        if path:
            self._bld_edit.setText(path)

    def _create_mesonferc(self):
        src = self._src_edit.text().strip()
        if not src:
            QMessageBox.warning(self.window(), 'No source directory',
                                'Set the source directory first.')
            return
        rc_path = Path(src) / '.mesonferc'
        if rc_path.exists():
            reply = QMessageBox.warning(
                self.window(), 'File exists',
                f'.mesonferc already exists in {src}\n\nOverwrite?',
                QMessageBox.Yes | QMessageBox.No,
                QMessageBox.No,
            )
            if reply != QMessageBox.Yes:
                return
        shutil.copy(_DEFAULT_RC_PATH, rc_path)
        QMessageBox.information(self.window(), 'Created', f'Created {rc_path}')

    def _auto_load_rc(self, src_path: Path):
        rc_path = src_path / '.mesonferc'
        if not rc_path.exists():
            rc_path = _DEFAULT_RC_PATH
        if rc_path.exists():
            self._load_rc(rc_path)

    def _load_rc(self, rc_path: Path):
        self._rc_data = load_mesonferc(rc_path)
        self._config_combo.blockSignals(True)
        self._config_combo.clear()
        self._config_combo.addItem('(default)')
        for name in self._rc_data['configs']:
            self._config_combo.addItem(name)
        self._config_combo.blockSignals(False)
        self._apply_config('(default)')

    def _load_from_mesonferc(self):
        src = self._src_edit.text().strip()
        if not src:
            QMessageBox.warning(self.window(), 'No source directory',
                                'Set the source directory first.')
            return
        rc_path = Path(src) / '.mesonferc'
        if not rc_path.exists():
            QMessageBox.information(self.window(), 'Not found',
                                    f'No .mesonferc found in {src}')
            return
        self._load_rc(rc_path)

    def _apply_config(self, name: str):
        if self._rc_data is None:
            return
        if name == '(default)':
            builddir = self._rc_data['default_builddir'] or '_build'
            opts = self._rc_data['options']
        else:
            cfg = self._rc_data['configs'].get(name, {})
            builddir = cfg.get('builddir') or self._rc_data['default_builddir'] or '_build'
            opts = {**self._rc_data['options'], **cfg.get('options', {})}
        self._bld_edit.setText(builddir)
        self._args_edit.setText(' '.join(f'-D{k}={v}' for k, v in opts.items()))

    def _on_config_changed(self, index: int):
        self._apply_config(self._config_combo.itemText(index))

    def _open_mesonferc(self):
        src = self._src_edit.text().strip()
        if not src:
            QMessageBox.warning(self.window(), 'No source directory',
                                'Set the source directory first.')
            return
        rc_path = Path(src) / '.mesonferc'
        if not rc_path.exists():
            QMessageBox.information(self.window(), 'Not found',
                                    f'No .mesonferc found in {src}')
            return
        QDesktopServices.openUrl(QUrl.fromLocalFile(str(rc_path)))

    def _run(self):
        src = self._src_edit.text().strip()
        bld = self._bld_edit.text().strip()
        if not src or not bld:
            QMessageBox.warning(self.window(), 'Missing fields',
                                'Source and build directories are required.')
            return
        args = ['setup', bld] + self._args_edit.text().split()
        self._out.clear()
        self._line_buf = ['']
        self._run_btn.setEnabled(False)
        self._proc.setWorkingDirectory(src)
        self._proc.start('meson', args)

    def _append(self, text: str):
        _append_highlighted(self._out, text, self._line_buf)

    def _on_finished(self, code: int, _status):
        self._append(f'\n[exited {code}]\n')
        self._run_btn.setEnabled(True)
        if code == 0:
            src = self._src_edit.text().strip()
