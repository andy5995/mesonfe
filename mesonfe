def _add_recent(path: Path, entry: Path) -> list:
    s = str(entry.resolve(strict=False))
    dirs = [d for d in _load_recent(path) if d != s]
    dirs.insert(0, s)
    dirs = dirs[:_RECENT_MAX]
    _save_recent(path, dirs)
    return dirs


