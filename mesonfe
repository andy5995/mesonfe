        self._append(f'\n[exited {code}]')
        self._btn.setEnabled(True)

    def closeEvent(self, event):
        if self._proc.state() != QProcess.NotRunning:
            self._proc.kill()
            self._proc.waitForFinished(2000)
        super().closeEvent(event)


class TestRunSelectDialog(QDialog):
    def __init__(self, parent: QWidget, items: list):
        super().__init__(parent)
        self.setWindowTitle('Tests')
        self.resize(360, 320)
        layout = QVBoxLayout(self)

        self._changing = False
        self._list = QListWidget()
        self._list.setSelectionMode(QListWidget.NoSelection)
        for i, (label, args) in enumerate(items):
            item = QListWidgetItem(label)
            item.setCheckState(Qt.Checked if i == 0 else Qt.Unchecked)
            item.setData(Qt.UserRole, args)
            self._list.addItem(item)
        self._list.itemChanged.connect(self._on_item_changed)
        self._list.itemClicked.connect(self._toggle_item)
        layout.addWidget(self._list)

        self._verbose = QCheckBox('Verbose')
        layout.addWidget(self._verbose)

        btns = QHBoxLayout()
        run_btn = QPushButton('Run Selected')
        run_btn.clicked.connect(self.accept)
        cancel_btn = QPushButton('Cancel')
        cancel_btn.clicked.connect(self.reject)
        btns.addStretch()
        btns.addWidget(run_btn)
        btns.addWidget(cancel_btn)
        layout.addLayout(btns)

    def _on_item_changed(self, changed_item):
        if self._changing:
            return
        self._changing = True
        default_item = self._list.item(0)
        if changed_item is default_item and changed_item.checkState() == Qt.Checked:
            for i in range(1, self._list.count()):
                self._list.item(i).setCheckState(Qt.Unchecked)
        elif changed_item is not default_item and changed_item.checkState() == Qt.Checked:
            default_item.setCheckState(Qt.Unchecked)
        self._changing = False

    def _toggle_item(self, item):
        item.setCheckState(Qt.Unchecked if item.checkState() == Qt.Checked else Qt.Checked)

    def selected(self):
        runs = [
            (self._list.item(i).text(), self._list.item(i).data(Qt.UserRole))
            for i in range(self._list.count())
            if self._list.item(i).checkState() == Qt.Checked
        ]
        return runs, self._verbose.isChecked()


class MultiTestOutputDialog(QDialog):
    def __init__(self, parent: QWidget, runs: list, builddir: Path):
        super().__init__(parent)
        self.setWindowTitle('Test Results')
        self.resize(720, 520)
        self._runs = list(runs)
        self._builddir = builddir
        self._idx = 0

        layout = QVBoxLayout(self)

        self._out = QTextEdit()
        self._out.setReadOnly(True)
        self._out.setFont(QFont('monospace', 10))
        layout.addWidget(self._out)

        self._btn = QPushButton('Close')
        self._btn.setEnabled(False)
        self._btn.clicked.connect(self.accept)
        layout.addWidget(self._btn)

        self._proc = QProcess(self)
        self._proc.setProcessChannelMode(QProcess.MergedChannels)
        self._proc.readyRead.connect(
            lambda: self._append(bytes(self._proc.readAll()).decode(errors='replace'))
        )
        self._proc.finished.connect(self._on_finished)
        self._run_next()

    def _run_next(self):
        label, args = self._runs[self._idx]
        self._append(f'=== {label} ===\n')
        self._proc.start('meson', ['test', '-C', str(self._builddir)] + args)

    def _append(self, text: str):
        self._out.moveCursor(QTextCursor.End)
        self._out.insertPlainText(text)

    def _on_finished(self, code: int, _status):
        self._append(f'[exited {code}]\n')
        self._idx += 1
        if self._idx < len(self._runs):
            self._append('\n')
            self._run_next()
        else:
            self._btn.setEnabled(True)

    def closeEvent(self, event):
        if self._proc.state() != QProcess.NotRunning:
            self._proc.kill()
            self._proc.waitForFinished(2000)
        super().closeEvent(event)


class ValueWidget(QWidget):
    def __init__(self, opt: dict):
        super().__init__()
        self._opt = opt
        layout = QHBoxLayout(self)
        layout.setContentsMargins(2, 1, 2, 1)
        layout.setSpacing(0)

        t, v = opt['type'], opt['value']

        if t == 'boolean':
            self._w = QComboBox()
            self._w.addItems(['true', 'false'])
            self._w.setCurrentText('true' if v else 'false')
        elif t in ('combo', 'feature'):
            self._w = QComboBox()
            choices = opt.get('choices') or (['enabled', 'disabled', 'auto'] if t == 'feature' else [])
            self._w.addItems([str(c) for c in choices])
            self._w.setCurrentText(str(v))
        elif t == 'array':
            self._w = QLineEdit(','.join(v) if isinstance(v, list) else str(v))
        else:
            self._w = QLineEdit(str(v))

        layout.addWidget(self._w)

    def current(self) -> str:
        return self._w.currentText() if isinstance(self._w, QComboBox) else self._w.text()

    def original(self) -> str:
        v = self._opt['value']
        if isinstance(v, bool):
            return 'true' if v else 'false'
        if isinstance(v, list):
            return ','.join(str(x) for x in v)
        return str(v)


