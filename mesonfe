            self._load_builddir(self._builddir)

    @staticmethod
    @staticmethod
    def _make_remove_icon(size: int = 16) -> QIcon:
        pix = QPixmap(size, size)
        pix.fill(Qt.transparent)
        painter = QPainter(pix)
        painter.setRenderHint(QPainter.Antialiasing)
        painter.setPen(Qt.NoPen)
        painter.setBrush(QColor('#cc2222'))
        painter.drawEllipse(0, 0, size, size)
        pen = QPen(QColor('white'), max(2, size // 5), Qt.SolidLine, Qt.RoundCap)
        painter.setPen(pen)
        margin = size // 4
        mid = size // 2
        painter.drawLine(margin, mid, size - margin, mid)
        painter.end()
        return QIcon(pix)

    def _remove_builddir(self):
        builddir = self._builddir.resolve(strict=False)
        reply = QMessageBox.warning(
            self, 'Remove build directory',
            f'Permanently delete\n{builddir}\n\nThis cannot be undone. Continue?',
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No,
        )
        if reply != QMessageBox.Yes:
            return
        try:
            shutil.rmtree(builddir)
        except OSError as e:
            QMessageBox.critical(self, 'Error', f'Failed to remove build directory:\n{e}')
            return
        source_dir = self._source_dir
        self._builddir = None
        self._source_dir = None
        if self._project_dir is None and source_dir:
            self._project_dir = source_dir
        self._setup_panel.set_project_dir(self._project_dir or source_dir, force=True)
        self.setWindowTitle('mesonfe')
        self._status_label.setText('No build directory')
        self._open_terminal_action.setEnabled(False)
        self._wipe_action.setEnabled(False)
        self._remove_builddir_action.setEnabled(False)
        placeholder = QWidget()
        lbl = QLabel('No build directory loaded.\nUse File → Open Build Directory…')
        lbl.setAlignment(Qt.AlignCenter)
        QVBoxLayout(placeholder).addWidget(lbl)
        self._set_build_options_widget(placeholder)
        self._set_tabs_enabled(False)
        self._tabs.setCurrentWidget(self._setup_panel)

    def _setup_from_mesonferc_file(self):
        source_dir = QFileDialog.getExistingDirectory(
            self, 'Select project directory containing .mesonferc'
        )
        if not source_dir:
            return
        source_dir = Path(source_dir)
        rc_path = source_dir / '.mesonferc'
        if not rc_path.exists():
            QMessageBox.warning(self, 'Not found',
                                f'No .mesonferc found in {source_dir}')
            return

        builddir_name = None
        for line in rc_path.read_text().splitlines():
            line = line.strip()
            if line.startswith('#') or '=' not in line:
                continue
            key, _, val = line.partition('=')
            if key.strip() == 'default_builddir':
                builddir_name = val.strip().strip('"')
                break

        if builddir_name:
            builddir = source_dir / builddir_name
        else:
            builddir_str = QFileDialog.getExistingDirectory(
                self, 'Select build directory', str(source_dir)
            )
            if not builddir_str:
                return
            builddir = Path(builddir_str)

        rc_options = load_mesonferc_options(rc_path)
        d_args = [f'-D{k}={v}' for k, v in rc_options.items()]
        has_build = (builddir / 'meson-info').exists()
        args = (['setup', str(source_dir), str(builddir)] +
                (['--reconfigure'] + d_args if has_build else d_args))
        dlg = MesonSetupDialog(self, args, self._output_font_size)
        dlg.exec_()
        if _is_build_dir(builddir):
            self._load_builddir(builddir)

