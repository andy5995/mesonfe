def _apply_theme(app, theme: str):
    if theme == 'dark':
        use_dark = True
    elif theme == 'light':
        use_dark = False
    else:
        use_dark = _SYSTEM_IS_DARK
    if use_dark:
        _apply_dark_theme(app, _CHECK_ICON_PATH, _ARROW_ICON_DARK_BG)
    else:
        _apply_light_theme(app, _CHECK_ICON_PATH, _ARROW_ICON_LIGHT_BG)
    for w in app.allWidgets():
        w.style().unpolish(w)
        w.style().polish(w)
        w.update()


def main():
    global _SYSTEM_IS_DARK, _CHECK_ICON_PATH, _ARROW_ICON_DARK_BG, _ARROW_ICON_LIGHT_BG
    ensure_default_mesonferc()
    app = QApplication(sys.argv)

    if _NLS:
        _locale_dir = _LOCALEDIR or str(Path(__file__).parent / 'po')
        _gettext.bindtextdomain('mesonfe', _locale_dir)
        _gettext.textdomain('mesonfe')

    _SYSTEM_IS_DARK  = _detect_system_dark()
    _CHECK_ICON_PATH = _ensure_check_icon()
    _ARROW_ICON_DARK_BG  = _ensure_arrow_icon('#8ec6f0', 'arrow_dark_bg.svg')
    _ARROW_ICON_LIGHT_BG = _ensure_arrow_icon('#333333', 'arrow_light_bg.svg')
    _apply_theme(app, load_settings().get('theme', 'auto'))
    icon = QIcon.fromTheme('mesonfe')
    if icon.isNull():
        for _p in [
            Path(__file__).parent / 'data' / 'mesonfe.svg',
            Path(_PKGDATADIR) / 'mesonfe.svg' if _PKGDATADIR else None,
        ]:
            if _p and _p.exists():
                icon = QIcon(str(_p))
                break
    if not icon.isNull():
        app.setWindowIcon(icon)
    builddir = find_builddir()
    if builddir is None and load_settings().get('reopen_last', False):
        recent = load_recent_dirs()
        if recent:
            builddir = Path(recent[0])
    win = MainWindow(builddir)
    win.show()
    _setup_color_scheme_watcher()
    sys.exit(app.exec_())


if __name__ == '__main__':
    main()
