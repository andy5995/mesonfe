class PanelDock(QDockWidget):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._resizing = False
        self._resize_edges = None
        self._resize_start_pos = None
        self._resize_start_geom = None
        self._context_menu_pos = None
        self._resize_timer = QTimer(self)
        self._resize_timer.setInterval(16)
        self._resize_timer.timeout.connect(self._poll_resize)

    def contextMenuEvent(self, event):
        if not self.isFloating():
            return
        self._context_menu_pos = self.mapFromGlobal(event.globalPos())
        menu = QMenu(self)
        menu.addAction('Resize').triggered.connect(self._begin_resize)
        menu.exec_(event.globalPos())

    def _begin_resize(self):
        # Edge is based on where the user right-clicked, not where the menu closed
        pos = self._context_menu_pos or self.rect().center()
        self._resize_edges = self._edges_for_pos(pos)
        self._resize_start_pos = QCursor.pos()
        self._resize_start_geom = self.geometry()
        self._resizing = True
        QApplication.instance().installEventFilter(self)
        QApplication.setOverrideCursor(self._cursor_for_pos(pos))
        self._resize_timer.start()

    def _cancel_resize(self):
        self._resize_timer.stop()
        self._resizing = False
        QApplication.instance().removeEventFilter(self)
        QApplication.restoreOverrideCursor()

    def _poll_resize(self):
        if self._resizing:
            self._apply_resize(QCursor.pos() - self._resize_start_pos)

    def eventFilter(self, obj, event):
        if not self._resizing:
            return super().eventFilter(obj, event)
        t = event.type()
        if t == QEvent.MouseButtonPress:
            self._cancel_resize()
            return True
        if t == QEvent.MouseButtonRelease:
            return True
        if t == QEvent.KeyPress:
            k = event.key()
            step = 10
            if k == Qt.Key_Escape:
                self.setGeometry(self._resize_start_geom)
                self._cancel_resize()
                return True
            if k in (Qt.Key_Return, Qt.Key_Enter):
                self._cancel_resize()
                return True
            if k == Qt.Key_Right:
                self.resize(self.width() + step, self.height())
                return True
            if k == Qt.Key_Left:
                self.resize(max(100, self.width() - step), self.height())
                return True
            if k == Qt.Key_Down:
                self.resize(self.width(), self.height() + step)
                return True
            if k == Qt.Key_Up:
                self.resize(self.width(), max(100, self.height() - step))
                return True
        return super().eventFilter(obj, event)

    def _apply_resize(self, delta):
        g = self._resize_start_geom
        edges = self._resize_edges
        x, y, w, h = g.x(), g.y(), g.width(), g.height()
        if edges & Qt.RightEdge:
            w = max(100, g.width() + delta.x())
        if edges & Qt.BottomEdge:
            h = max(100, g.height() + delta.y())
        if edges & Qt.LeftEdge:
            new_w = max(100, g.width() - delta.x())
            x = g.x() + g.width() - new_w
            w = new_w
        if edges & Qt.TopEdge:
            new_h = max(100, g.height() - delta.y())
            y = g.y() + g.height() - new_h
            h = new_h
        self.setGeometry(x, y, w, h)

    def _edges_for_pos(self, pos):
        # Always return a corner so movement in any direction resizes
        h_edge = Qt.RightEdge if pos.x() >= self.width() / 2 else Qt.LeftEdge
        v_edge = Qt.BottomEdge if pos.y() >= self.height() / 2 else Qt.TopEdge
        return h_edge | v_edge

    def _cursor_for_pos(self, pos):
        right_half = pos.x() >= self.width() / 2
        bottom_half = pos.y() >= self.height() / 2
        if right_half == bottom_half:   # top-left or bottom-right corner
            return Qt.SizeFDiagCursor
        return Qt.SizeBDiagCursor


class ValueWidget(QWidget):
    def __init__(self, opt: dict):
        super().__init__()
        self._opt = opt
        layout = QHBoxLayout(self)
        layout.setContentsMargins(2, 1, 2, 1)
        layout.setSpacing(0)

        t, v = opt['type'], opt['value']

        if t == 'boolean':
            self._w = QComboBox()
            self._w.addItems(['true', 'false'])
            self._w.setCurrentText('true' if v else 'false')
        elif t in ('combo', 'feature'):
            self._w = QComboBox()
            choices = opt.get('choices') or (['enabled', 'disabled', 'auto'] if t == 'feature' else [])
            self._w.addItems([str(c) for c in choices])
            self._w.setCurrentText(str(v))
        elif t == 'array':
            self._w = QLineEdit(','.join(v) if isinstance(v, list) else str(v))
        else:
            self._w = QLineEdit(str(v))

        layout.addWidget(self._w)

    def current(self) -> str:
        return self._w.currentText() if isinstance(self._w, QComboBox) else self._w.text()

    def original(self) -> str:
        v = self._opt['value']
        if isinstance(v, bool):
            return 'true' if v else 'false'
        if isinstance(v, list):
            return ','.join(str(x) for x in v)
        return str(v)


class MesonHighlighter(QSyntaxHighlighter):
    _KEYWORDS = frozenset((
        'project', 'executable', 'library', 'shared_library', 'static_library',
        'both_libraries', 'shared_module', 'dependency', 'declare_dependency',
        'find_program', 'import', 'subdir', 'subproject', 'files', 'include_directories',
        'install_data', 'install_headers', 'install_man', 'install_subdir',
        'configure_file', 'custom_target', 'run_command', 'run_target',
        'test', 'benchmark', 'add_test_setup', 'add_project_arguments',
        'add_global_arguments', 'add_project_link_arguments',
        'get_option', 'option', 'message', 'warning', 'error', 'assert',
        'environment', 'generator', 'join_paths', 'build_target',
        'if', 'elif', 'else', 'endif', 'foreach', 'endforeach',
        'and', 'or', 'not', 'in', 'continue', 'break',
        'true', 'false',
    ))

    def __init__(self, document):
        super().__init__(document)

        def fmt(color, bold=False):
            f = QTextCharFormat()
            f.setForeground(QColor(color))
            if bold:
                f.setFontWeight(QFont.Bold)
            return f

        self._fmt_kw      = fmt('#569cd6', bold=True)
        self._fmt_str     = fmt('#ce9178')
        self._fmt_comment = fmt('#6a9955')
        self._fmt_num     = fmt('#b5cea8')
        self._fmt_func    = fmt('#dcdcaa')
        self._fmt_interp  = fmt('#4ec9b0')

        self._re_token = re.compile(
            r"'''|'|#|@\w+@|\b\d+(?:\.\d+)?\b|[A-Za-z_]\w*"
        )
        self._re_num   = re.compile(r'^\d')
        self._re_ident = re.compile(r'^[A-Za-z_]')

    def highlightBlock(self, text):
        in_triple = self.previousBlockState() == 1
        self.setCurrentBlockState(0)
        i = 0
        n = len(text)

        if in_triple:
            end = text.find("'''", i)
            if end == -1:
                self.setFormat(0, n, self._fmt_str)
                self.setCurrentBlockState(1)
                return
            self.setFormat(0, end + 3, self._fmt_str)
            i = end + 3

        while i < n:
            m = self._re_token.search(text, i)
            if not m:
                break
            s, tok = m.start(), m.group()

            if tok == "'''":
                end = text.find("'''", s + 3)
                if end == -1:
                    self.setFormat(s, n - s, self._fmt_str)
                    self.setCurrentBlockState(1)
                    return
                self.setFormat(s, end + 3 - s, self._fmt_str)
                i = end + 3

            elif tok == "'":
                j = s + 1
                while j < n:
                    if text[j] == '\\':
                        j += 2
                    elif text[j] == "'":
                        j += 1
                        break
                    else:
                        j += 1
                self.setFormat(s, j - s, self._fmt_str)
                i = j

            elif tok == '#':
                self.setFormat(s, n - s, self._fmt_comment)
                return

            elif tok.startswith('@'):
                self.setFormat(s, len(tok), self._fmt_interp)
                i = s + len(tok)

            elif self._re_num.match(tok):
                self.setFormat(s, len(tok), self._fmt_num)
                i = s + len(tok)

            else:
                # identifier — keyword, function call, or plain
                i = s + len(tok)
                if tok in self._KEYWORDS:
                    self.setFormat(s, len(tok), self._fmt_kw)
                elif i < n and text[i:].lstrip(' \t').startswith('('):
                    self.setFormat(s, len(tok), self._fmt_func)
                # else plain identifier, no colour


class BuildFileViewer(QDialog):
    def __init__(self, path, source_dir, parent=None):
        p = Path(path)
