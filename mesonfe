    def _toggle_tab(self, key, label, visible):
        widget = self._optional_tab_widgets[key]
        if visible:
            pos = 2
            for k, _, _ in _OPTIONAL_TABS:
                if k == key:
                    break
                if self._tab_actions[k].isChecked():
                    pos += 1
            self._tabs.insertTab(pos, widget, label)
            self._tabs.tabBar().setTabButton(pos, QTabBar.RightSide, self._make_close_btn(key))
            self._tabs.setCurrentWidget(widget)
        else:
            idx = self._tabs.indexOf(widget)
            if idx >= 0:
                self._tabs.removeTab(idx)
        save_json_file(_TAB_VIS_PATH, {k: self._tab_actions[k].isChecked() for k, _, _ in _OPTIONAL_TABS})

