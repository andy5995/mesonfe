    def _open_terminal(self):
        if not self._builddir:
            return
        cwd = str(self._builddir.resolve(strict=False))
        system = platform.system()
        # Each entry: (cmd, popen_cwd) — popen_cwd=None means the dir is already in cmd args.
        if system == 'Windows':
            candidates = [
                (['wt.exe', '-d', cwd], None),   # Windows Terminal
                (['pwsh.exe'],          cwd),     # PowerShell Core
                (['powershell.exe'],    cwd),     # Windows PowerShell
                (['cmd.exe'],           cwd),     # Command Prompt
            ]
        elif system == 'Darwin':
            candidates = [
                (['open', '-a', 'Terminal', cwd], None),  # Terminal.app
                (['open', '-a', 'iTerm', cwd],    None),  # iTerm2
            ]
        else:
            # DE-aware launchers first; terminals that need explicit flags next;
            # simple terminals that inherit process cwd last.
            candidates = [
                (['exo-open', '--launch', 'TerminalEmulator', '--working-directory', cwd], None),
                (['x-terminal-emulator'],                                                   cwd),
                (['gnome-terminal', f'--working-directory={cwd}'],                         None),
                (['konsole', '--workdir', cwd],                                            None),
                (['xfce4-terminal', '--working-directory', cwd],                           None),
                (['xterm'],                                                                 cwd),
                (['alacritty'],                                                             cwd),
                (['kitty'],                                                                 cwd),
                (['lxterminal'],                                                            cwd),
                (['mate-terminal'],                                                         cwd),
                (['tilix'],                                                                 cwd),
            ]
        term = self._pref_terminal or os.environ.get('TERMINAL', '')
        if term:
            candidates.insert(0, ([term], cwd))
        for cmd, popen_cwd in candidates:
            try:
                subprocess.Popen(cmd, cwd=popen_cwd)
                return
            except (FileNotFoundError, OSError):
                continue
        QMessageBox.warning(
            self, 'No terminal found',
            'Could not find a terminal emulator.\n'
            'Set the $TERMINAL environment variable to your preferred terminal.',
        )

    def _open_file_manager(self):
        if not self._builddir:
            return
        path = str(self._builddir.resolve(strict=False))
        if self._pref_file_manager:
            try:
                subprocess.Popen([self._pref_file_manager, path])
                return
            except (FileNotFoundError, OSError):
                pass
        QDesktopServices.openUrl(QUrl.fromLocalFile(path))

