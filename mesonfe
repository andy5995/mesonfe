    def _set_all(self, checked):
        state = Qt.Checked if checked else Qt.Unchecked
        for i in range(self._sp_list.count()):
            self._sp_list.item(i).setCheckState(state)

    def set_source_dir(self, source_dir):
        self._source_dir = source_dir
        self._sp_list.clear()
        has_wraps = False
        if source_dir:
            sp_dir = source_dir / 'subprojects'
            if sp_dir.is_dir():
                for wrap in sorted(sp_dir.glob('*.wrap')):
                    item = QListWidgetItem(wrap.stem)
                    item.setCheckState(Qt.Checked)
                    self._sp_list.addItem(item)
                has_wraps = self._sp_list.count() > 0
        self._run_btn.setEnabled(source_dir is not None)
        self._all_btn.setEnabled(has_wraps)
        self._none_btn.setEnabled(has_wraps)

    def _run(self):
        self._out.clear()
        self._line_buf[0] = ''
        self._run_btn.setEnabled(False)
        args = ['subprojects', 'update', '--sourcedir', str(self._source_dir)]
        if self._reset.isChecked():
            args.append('--reset')
        if self._allow_insecure.isChecked():
            args.append('--allow-insecure')
        if self._jobs.value() > 0:
            args += ['-j', str(self._jobs.value())]
        total = self._sp_list.count()
        selected = [self._sp_list.item(i).text() for i in range(total)
                    if self._sp_list.item(i).checkState() == Qt.Checked]
        if 0 < len(selected) < total:
            args.extend(selected)
        self._proc.start('meson', args)

    def _append(self, text: str):
        _append_highlighted(self._out, text, self._line_buf)

    def _on_finished(self, code: int, _status):
        self._append(f'\n[exited {code}]\n')
        self._run_btn.setEnabled(True)

    def closeEvent(self, event):
        if self._proc.state() != QProcess.NotRunning:
            self._proc.kill()
            self._proc.waitForFinished(2000)
        super().closeEvent(event)


class TestPanel(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self._builddir = None
        self._runs = []
        self._run_idx = 0
        self._changing = False
        self._checkbox_just_clicked = False
        layout = QVBoxLayout(self)

        splitter = QSplitter(Qt.Vertical)

        top = QWidget()
        top_layout = QVBoxLayout(top)
        top_layout.setContentsMargins(0, 0, 0, 0)
        self._list = QListWidget()
        self._list.setSelectionMode(QListWidget.NoSelection)
        self._list.itemChanged.connect(self._on_item_changed)
        self._list.itemClicked.connect(self._toggle_item)
        top_layout.addWidget(self._list)
        opts = QHBoxLayout()
        self._verbose = QCheckBox('Verbose')
        opts.addWidget(self._verbose)
        self._run_btn = QPushButton('Run Selected')
        self._run_btn.setEnabled(False)
        self._run_btn.clicked.connect(self._run)
        opts.addStretch()
        opts.addWidget(self._run_btn)
        top_layout.addLayout(opts)
        splitter.addWidget(top)

        self._out = QTextEdit()
        self._out.setReadOnly(True)
        self._out.setFont(QFont('monospace', 10))
        splitter.addWidget(self._out)

        splitter.setStretchFactor(0, 1)
        splitter.setStretchFactor(1, 2)
        layout.addWidget(splitter)

        self._proc = QProcess(self)
        self._proc.setProcessChannelMode(QProcess.MergedChannels)
        self._proc.readyRead.connect(
            lambda: self._append(bytes(self._proc.readAll()).decode(errors='replace'))
        )
        self._proc.finished.connect(self._on_finished)
        self._line_buf = ['']

    def set_builddir(self, builddir):
        self._builddir = builddir

    def set_test_items(self, items):
        self._list.clear()
        for i, (label, args) in enumerate(items):
            item = QListWidgetItem(label)
            item.setCheckState(Qt.Checked if i == 0 else Qt.Unchecked)
            item.setData(Qt.UserRole, args)
            self._list.addItem(item)
        self._run_btn.setEnabled(bool(items) and self._builddir is not None)

    def _apply_mutual_exclusion(self, changed_item):
        self._changing = True
        default_item = self._list.item(0)
        if changed_item is default_item and changed_item.checkState() == Qt.Checked:
            for i in range(1, self._list.count()):
                self._list.item(i).setCheckState(Qt.Unchecked)
        elif changed_item is not default_item and changed_item.checkState() == Qt.Checked:
            default_item.setCheckState(Qt.Unchecked)
        self._changing = False

    def _on_item_changed(self, changed_item):
        if self._changing:
            return
        self._checkbox_just_clicked = True
        self._apply_mutual_exclusion(changed_item)

    def _toggle_item(self, item):
        if self._checkbox_just_clicked:
            self._checkbox_just_clicked = False
            return
        new_state = Qt.Unchecked if item.checkState() == Qt.Checked else Qt.Checked
        self._changing = True
        item.setCheckState(new_state)
        self._changing = False
        self._apply_mutual_exclusion(item)

    def _run(self):
        runs = [
            (self._list.item(i).text(), self._list.item(i).data(Qt.UserRole))
            for i in range(self._list.count())
            if self._list.item(i).checkState() == Qt.Checked
        ]
        if not runs:
            return
        if self._verbose.isChecked():
            runs = [(label, args + ['--verbose']) for label, args in runs]
        self._runs = runs
        self._run_idx = 0
        self._out.clear()
        self._line_buf[0] = ''
        self._run_btn.setEnabled(False)
        self._run_next()

    def _run_next(self):
        label, args = self._runs[self._run_idx]
        self._append(f'=== {label} ===\n')
        self._proc.start('meson', ['test', '-C', str(self._builddir)] + args)

    def _append(self, text: str):
        _append_highlighted(self._out, text, self._line_buf)

    def _on_finished(self, code: int, _status):
        self._append(f'[exited {code}]\n')
        self._run_idx += 1
        if self._run_idx < len(self._runs):
            self._append('\n')
            self._run_next()
        else:
            self._run_btn.setEnabled(True)

    def closeEvent(self, event):
        if self._proc.state() != QProcess.NotRunning:
            self._proc.kill()
            self._proc.waitForFinished(2000)
        super().closeEvent(event)


