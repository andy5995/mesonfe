def main():
    ensure_default_mesonferc()
    app = QApplication(sys.argv)
    _apply_dark_theme(app)
    icon = QIcon.fromTheme('mesonfe')
    if icon.isNull():
        for _p in [
            Path(__file__).parent / 'data' / 'mesonfe.svg',
            Path(_PKGDATADIR) / 'mesonfe.svg' if _PKGDATADIR else None,
        ]:
            if _p and _p.exists():
                icon = QIcon(str(_p))
                break
    if not icon.isNull():
        app.setWindowIcon(icon)
    builddir = find_builddir()
    if builddir is None and load_settings().get('reopen_last', False):
        recent = load_recent_dirs()
        if recent:
            builddir = Path(recent[0])
    win = MainWindow(builddir)
    win.show()
    sys.exit(app.exec_())


if __name__ == '__main__':
    main()
