def load_recent_dirs() -> list:
    data = read_json(_RECENT_PATH)
    if isinstance(data, list):
        return [p for p in data if Path(p).exists()]
    return []


def save_recent_dirs(dirs: list):
    _RECENT_PATH.parent.mkdir(parents=True, exist_ok=True)
    _RECENT_PATH.write_text(json.dumps(dirs, indent=2))


def add_recent_dir(builddir: Path) -> list:
    entry = str(builddir.resolve(strict=False))
    dirs = [d for d in load_recent_dirs() if d != entry]
    dirs.insert(0, entry)
    dirs = dirs[:_RECENT_MAX]
    save_recent_dirs(dirs)
    return dirs


class KeybindingsDialog(QDialog):
    def __init__(self, parent, action_map: dict):
        super().__init__(parent)
        self.setWindowTitle('Configure Keybindings')
        self.resize(480, 380)
        layout = QVBoxLayout(self)

        self._editors = {}
        tbl = QTableWidget(len(action_map), 2, self)
        tbl.setHorizontalHeaderLabels(['Action', 'Shortcut'])
        tbl.horizontalHeader().setSectionResizeMode(0, QHeaderView.Stretch)
        tbl.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeToContents)
        tbl.verticalHeader().setVisible(False)
        tbl.setSelectionMode(QTableWidget.NoSelection)
        tbl.setEditTriggers(QTableWidget.NoEditTriggers)

        for row, (action_id, (name, action)) in enumerate(action_map.items()):
            item = QTableWidgetItem(name)
            item.setFlags(Qt.ItemIsEnabled)
            tbl.setItem(row, 0, item)
            editor = QKeySequenceEdit(action.shortcut())
            self._editors[action_id] = editor
            tbl.setCellWidget(row, 1, editor)

        tbl.resizeRowsToContents()
        layout.addWidget(tbl)

        btns = QHBoxLayout()
        reset_btn = QPushButton('Reset to Defaults')
        reset_btn.clicked.connect(self._reset)
        ok_btn = QPushButton('OK')
        ok_btn.clicked.connect(self.accept)
        cancel_btn = QPushButton('Cancel')
        cancel_btn.clicked.connect(self.reject)
        btns.addWidget(reset_btn)
        btns.addStretch()
        btns.addWidget(ok_btn)
        btns.addWidget(cancel_btn)
        layout.addLayout(btns)

    def _reset(self):
        for action_id, editor in self._editors.items():
            editor.setKeySequence(QKeySequence(_DEFAULT_SHORTCUTS[action_id]))

    def get_shortcuts(self) -> dict:
        return {aid: self._editors[aid].keySequence().toString()
                for aid in self._editors}


_HL_ERROR = re.compile(r'\berror\b', re.IGNORECASE)
_HL_WARN  = re.compile(r'\bwarning\b', re.IGNORECASE)
_HL_NOTE  = re.compile(r'\bnote\b', re.IGNORECASE)
_HL_EXIT  = re.compile(r'^\[exited (\d+)\]')


def _append_highlighted(out, text, buf):
    combined = buf[0] + text
    parts = combined.split('\n')
    if combined.endswith('\n'):
        buf[0] = ''
        lines = parts[:-1]
    else:
        buf[0] = parts[-1]
        lines = parts[:-1]
    cursor = out.textCursor()
    cursor.movePosition(QTextCursor.End)
    for line in lines:
        fmt = QTextCharFormat()
        m = _HL_EXIT.match(line.strip())
        if m:
            fmt.setForeground(QColor('#90ee90' if m.group(1) == '0' else '#ff6b6b'))
        elif _HL_ERROR.search(line) or 'FAILED' in line:
            fmt.setForeground(QColor('#ff6b6b'))
        elif _HL_WARN.search(line):
            fmt.setForeground(QColor('#f0c060'))
        elif _HL_NOTE.search(line):
            fmt.setForeground(QColor('#87ceeb'))
        cursor.insertText(line + '\n', fmt)
    out.setTextCursor(cursor)
    out.ensureCursorVisible()


class MesonSetupDialog(QDialog):
    def __init__(self, parent: QWidget, args: list, font_size: int = _DEFAULT_OUTPUT_FONT_SIZE):
        super().__init__(parent)
        self.setWindowTitle('meson setup')
        self.resize(720, 480)
        layout = QVBoxLayout(self)
        self._out = QTextEdit()
        self._out.setReadOnly(True)
        self._out.setFont(QFont('monospace', font_size))
        layout.addWidget(self._out)
        self._btn = QPushButton('Close')
        self._btn.setEnabled(False)
        self._btn.clicked.connect(self.accept)
        layout.addWidget(self._btn)
        self._proc = QProcess(self)
        self._proc.setProcessChannelMode(QProcess.MergedChannels)
        self._proc.readyRead.connect(
            lambda: self._append(bytes(self._proc.readAll()).decode(errors='replace'))
        )
        self._proc.finished.connect(self._on_finished)
        self._line_buf = ['']
        self._proc.start('meson', args)

    def _append(self, text: str):
        _append_highlighted(self._out, text, self._line_buf)

    def _on_finished(self, code: int, _status):
        self._append(f'\n[exited {code}]\n')
        self._btn.setEnabled(True)

    def closeEvent(self, event):
        if self._proc.state() != QProcess.NotRunning:
            self._proc.kill()
            self._proc.waitForFinished(2000)
        super().closeEvent(event)


