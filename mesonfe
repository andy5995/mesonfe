class KeybindingsDialog(QDialog):
    applied = pyqtSignal(dict)

    def __init__(self, parent, action_map: dict):
        super().__init__(parent)
        self.setWindowTitle('Configure Keybindings')
        self.resize(480, 380)
        layout = QVBoxLayout(self)

        self._editors = {}
        tbl = QTableWidget(len(action_map), 2, self)
        tbl.setHorizontalHeaderLabels(['Action', 'Shortcut'])
        tbl.horizontalHeader().setSectionResizeMode(0, QHeaderView.Stretch)
        tbl.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeToContents)
        tbl.verticalHeader().setVisible(False)
        tbl.setSelectionMode(QTableWidget.NoSelection)
        tbl.setEditTriggers(QTableWidget.NoEditTriggers)

        for row, (action_id, (name, action)) in enumerate(action_map.items()):
            item = QTableWidgetItem(name)
            item.setFlags(Qt.ItemIsEnabled)
            tbl.setItem(row, 0, item)
            editor = QKeySequenceEdit(action.shortcut())
            self._editors[action_id] = editor
            tbl.setCellWidget(row, 1, editor)

        tbl.resizeRowsToContents()
        layout.addWidget(tbl)

        btns = QHBoxLayout()
        reset_btn = QPushButton('Reset to Defaults')
        reset_btn.clicked.connect(self._reset)
        ok_btn = QPushButton('OK')
        ok_btn.clicked.connect(self.accept)
        apply_btn = QPushButton(_('Apply'))
        apply_btn.clicked.connect(lambda: self.applied.emit(self.get_shortcuts()))
        cancel_btn = QPushButton('Cancel')
        cancel_btn.clicked.connect(self.reject)
        btns.addWidget(reset_btn)
        btns.addStretch()
