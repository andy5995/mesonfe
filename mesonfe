        if path:
            self._load_builddir(Path(path))

    def _open_project_dir(self):
        path = QFileDialog.getExistingDirectory(self, 'Select Project Directory')
        if not path:
            return
        self._project_dir = Path(path)
        self._setup_panel.set_project_dir(self._project_dir, force=True)
        self._update_setup_tab_state()
        self._tabs.setCurrentWidget(self._setup_panel)

    def _on_setup_done(self, bld_path: str):
        self._load_builddir(Path(bld_path))

    def _load_builddir(self, builddir: Path):
        if not _is_build_dir(builddir):
            QMessageBox.warning(self, 'Not a build directory',
                                f'{builddir} does not look like a Meson build directory.')
            return
        self._builddir = builddir
        self._rebuild()

    def _clear_recent(self):
        save_recent_dirs([])
        self._refresh_recent_menu()

    def _jump_to_option(self, row, _col):
        if self._changed_tbl is None:
            return
        name = self._changed_tbl.item(row, 0).text()
        self._tabs.setCurrentIndex(1)  # Build Options is always at index 1
        for r in range(self._tbl.rowCount()):
            item = self._tbl.item(r, 0)
            if item and item.text() == name:
                self._tbl.scrollToItem(item)
                self._tbl.selectRow(r)
                break

    def _apply_shortcuts(self, overrides: dict):
        for action_id, (_name, action) in self._action_map.items():
            key = overrides.get(action_id, _DEFAULT_SHORTCUTS[action_id])
            action.setShortcut(QKeySequence(key))

    def _show_about(self):
        QMessageBox.about(
            self,
            'About mesonfe',
            f'<b>mesonfe</b> {"v" + VERSION if VERSION != "unknown" else "(development)"}<br>'
            'A PyQt5 GUI frontend for Meson build options.<br><br>'
            f'<a href="{_URL}">{_URL}</a><br><br>'
            'License: MIT<br><br>'
            '<i>Disclaimer: This project is not affiliated with or endorsed by the '
            '<a href="https://mesonbuild.com/">Meson project</a> or its developers.</i>',
        )

    def _open_terminal(self):
        if not self._builddir:
            return
        cwd = str(self._builddir.resolve(strict=False))
        system = platform.system()
        # Each entry: (cmd, popen_cwd) — popen_cwd=None means the dir is already in cmd args.
        if system == 'Windows':
            candidates = [
                (['wt.exe', '-d', cwd], None),   # Windows Terminal
                (['pwsh.exe'],          cwd),     # PowerShell Core
                (['powershell.exe'],    cwd),     # Windows PowerShell
                (['cmd.exe'],           cwd),     # Command Prompt
            ]
        elif system == 'Darwin':
            candidates = [
                (['open', '-a', 'Terminal', cwd], None),  # Terminal.app
                (['open', '-a', 'iTerm', cwd],    None),  # iTerm2
            ]
        else:
            # DE-aware launchers first; terminals that need explicit flags next;
            # simple terminals that inherit process cwd last.
            candidates = [
                (['exo-open', '--launch', 'TerminalEmulator', '--working-directory', cwd], None),
                (['x-terminal-emulator'],                                                   cwd),
                (['gnome-terminal', f'--working-directory={cwd}'],                         None),
                (['konsole', '--workdir', cwd],                                            None),
                (['xfce4-terminal', '--working-directory', cwd],                           None),
                (['xterm'],                                                                 cwd),
                (['alacritty'],                                                             cwd),
                (['kitty'],                                                                 cwd),
                (['lxterminal'],                                                            cwd),
                (['mate-terminal'],                                                         cwd),
                (['tilix'],                                                                 cwd),
            ]
        term = os.environ.get('TERMINAL', '')
        if term:
            candidates.insert(0, ([term], cwd))
        for cmd, popen_cwd in candidates:
            try:
                subprocess.Popen(cmd, cwd=popen_cwd)
                return
            except (FileNotFoundError, OSError):
                continue
        QMessageBox.warning(
            self, 'No terminal found',
            'Could not find a terminal emulator.\n'
            'Set the $TERMINAL environment variable to your preferred terminal.',
        )

    def _apply(self):
        defs = []
        for r in range(self._tbl.rowCount()):
            if self._tbl.isRowHidden(r):
                continue
            w = self._tbl.cellWidget(r, 2)
            if w.current() != w.original():
                val = os.path.expandvars(os.path.expanduser(w.current()))
                defs.append(f"-D{self._options[r]['name']}={val}")

        if not defs:
            QMessageBox.information(self, 'No changes', 'No options were modified.')
            return

        result = subprocess.run(
            ['meson', 'configure', str(self._builddir)] + defs,
            capture_output=True, text=True
        )
        if result.returncode == 0:
            QMessageBox.information(self, 'Done', f'Applied {len(defs)} change(s).')
            self._rebuild()
        else:
            QMessageBox.critical(self, 'Error', result.stderr or result.stdout or 'meson configure failed')


def _apply_dark_theme(app):
