    def _rebuild(self):
        if self._builddir:
            add_recent_dir(self._builddir)
        self._refresh_recent_menu()
        options, setups, source_dir, project_name = load_project_data(self._builddir)
        self._options = options
        self._setups = setups
        self._source_dir = source_dir
        label = f'{project_name}  |  {self._builddir.resolve(strict=False).name}' if project_name else self._builddir.resolve(strict=False).name
        self._status_label.setText(label)
        defaults = parse_defaults(source_dir) if source_dir else {}

        root_w = QWidget()
        self.setCentralWidget(root_w)
        layout = QVBoxLayout(root_w)
        layout.setSpacing(6)

        # Changed from defaults
        cmd_line_opts = parse_cmd_line(self._builddir)
        changed = []
        seen = set()
        for opt in options:
            name = opt['name']
            if name in defaults and str(opt['value']).lower() != str(defaults[name]).lower():
                changed.append((opt, defaults[name]))
                seen.add(name)
        for opt in options:
            name = opt['name']
            if name in cmd_line_opts and name not in seen:
                changed.append((opt, None))

        self._changed = changed
        self._save_rc_action.setEnabled(bool(source_dir))
        self._setup_rc_action.setEnabled(
            bool(source_dir and (source_dir / '.mesonferc').exists())
        )

        if changed:
            tbl = QTableWidget(len(changed), 3)
            tbl.setHorizontalHeaderLabels(['Option', 'Current value', 'Default'])
            tbl.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
            tbl.setEditTriggers(QTableWidget.NoEditTriggers)
            tbl.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
            for r, (opt, dflt) in enumerate(changed):
                tbl.setItem(r, 0, QTableWidgetItem(opt['name']))
                cur = QTableWidgetItem(str(opt['value']))
                cur.setForeground(QColor('#ff6b6b'))
                tbl.setItem(r, 1, cur)
                tbl.setItem(r, 2, QTableWidgetItem('—' if dflt is None else str(dflt)))
            row_h = tbl.verticalHeader().defaultSectionSize()
            header_h = tbl.horizontalHeader().sizeHint().height()
            self._changed_max_h = 4 * row_h + header_h
            tbl.setMaximumHeight(self._changed_max_h)
            tbl.cellClicked.connect(self._jump_to_option)
            self._changed_dock.setWidget(tbl)
            self._changed_dock.show()
        else:
            self._changed_dock.hide()

        # Build test items for the menu action
        suites = find_test_suites(self._builddir)
        if suites or setups:
            self._test_items = [('Default', [])]
            for s in suites:
                self._test_items.append((f'Suite: {s}', ['--suite', s]))
            for name in setups:
                self._test_items.append((f'Setup: {name}', ['--setup', name]))
        else:
            self._test_items = []
        self._run_tests_action.setEnabled(bool(self._test_items))
        self._compile_action.setEnabled(True)
        self._install_action.setEnabled(True)
        self._dist_action.setEnabled(True)
        self._subprojects_update_action.setEnabled(bool(source_dir))
        self._open_terminal_action.setEnabled(True)

        # All options
        grp = QGroupBox('Build Options')
        gl = QVBoxLayout(grp)

        frow = QHBoxLayout()
        frow.addWidget(QLabel('Filter:'))
        self._filter = QLineEdit()
        self._filter.setPlaceholderText('name or description')
        self._filter.textChanged.connect(self._do_filter)
        frow.addWidget(self._filter)
        gl.addLayout(frow)

        self._tbl = QTableWidget(len(options), 4)
        self._tbl.setHorizontalHeaderLabels(['Name', 'Type', 'Value', 'Description'])
        hh = self._tbl.horizontalHeader()
        hh.setSectionResizeMode(0, QHeaderView.ResizeToContents)
        hh.setSectionResizeMode(1, QHeaderView.ResizeToContents)
        hh.setSectionResizeMode(2, QHeaderView.Interactive)
        hh.setSectionResizeMode(3, QHeaderView.Stretch)
        self._tbl.setColumnWidth(2, 200)
        self._tbl.verticalHeader().setVisible(False)
        self._tbl.setEditTriggers(QTableWidget.NoEditTriggers)
        self._tbl.setSelectionBehavior(QTableWidget.SelectRows)

        for r, opt in enumerate(options):
            self._tbl.setItem(r, 0, QTableWidgetItem(opt['name']))
            self._tbl.setItem(r, 1, QTableWidgetItem(opt['type']))
            self._tbl.setCellWidget(r, 2, ValueWidget(opt))
            self._tbl.setItem(r, 3, QTableWidgetItem(opt.get('description', '')))

        gl.addWidget(self._tbl)

        apply_btn = QPushButton('Apply Changes')
        apply_btn.clicked.connect(self._apply)
        gl.addWidget(apply_btn, alignment=Qt.AlignRight)

        layout.addWidget(grp, 1)

    def _do_filter(self, text: str):
        text = text.lower()
        for r in range(self._tbl.rowCount()):
            name = self._tbl.item(r, 0).text().lower()
            desc = self._tbl.item(r, 3).text().lower()
            self._tbl.setRowHidden(r, bool(text) and text not in name and text not in desc)

