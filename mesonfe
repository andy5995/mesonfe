def _is_build_dir(path: Path) -> bool:
    return (path / 'meson-info').is_dir() or (path / 'meson-private').is_dir()


def find_builddir():
    if len(sys.argv) > 1:
        return Path(sys.argv[1])
    if _is_build_dir(Path('.')):
        return Path('.')
    for base in (Path('.'), Path('..')):
        rc = base / '.mesonferc'
        if rc.exists():
            for line in rc.read_text().splitlines():
                line = line.strip()
                if line.startswith('#') or '=' not in line:
                    continue
                key, _, val = line.partition('=')
                if key.strip() == 'default_builddir':
                    return base / val.strip().strip('"')
            return base / 'builddir'
    return None


def read_json(path: Path):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def find_test_suites(builddir: Path) -> list:
    tests = read_json(builddir / 'meson-info' / 'intro-tests.json') or []
    seen = set()
    suites = []
    for t in tests:
        for s in t.get('suite', []):
            if s not in seen:
                seen.add(s)
                suites.append(s)
    return suites


def find_test_setups(builddir: Path) -> list:
    build_files = read_json(builddir / 'meson-info' / 'intro-buildsystem_files.json') or []
    setups = []
    for f in build_files:
        try:
            text = Path(f).read_text()
            setups.extend(re.findall(r"add_test_setup\s*\(\s*['\"]([^'\"]+)['\"]", text))
        except (OSError, UnicodeDecodeError):
            pass
    return setups


def load_project_data(builddir: Path):
    info_dir = builddir / 'meson-info'
    options = read_json(info_dir / 'intro-buildoptions.json') or []
    source_dir = None
    project_name = None
    info = read_json(info_dir / 'meson-info.json')
    if info:
        src = info.get('directories', {}).get('source')
        if src:
            source_dir = Path(src)
    proj = read_json(info_dir / 'intro-projectinfo.json')
    if proj:
        project_name = proj.get('descriptive_name')
    test_setups = find_test_setups(builddir)
    return options, test_setups, source_dir, project_name


def parse_defaults(source_dir: Path) -> dict:
    defaults = {}
    for fname in ('meson.options', 'meson_options.txt'):
        f = source_dir / fname
        if not f.exists():
            continue
        for m in re.finditer(r"option\s*\(\s*'([^']+)'([^)]*)\)", f.read_text(), re.DOTALL):
            name, body = m.group(1), m.group(2)
            vm = re.search(r"\bvalue\s*:\s*(['\"]?)([^,)'\"]+)\1", body)
            if not vm:
                continue
            raw = vm.group(2).strip()
            if raw == 'true':
                defaults[name] = True
            elif raw == 'false':
                defaults[name] = False
            elif re.fullmatch(r'-?\d+', raw):
                defaults[name] = int(raw)
            else:
                defaults[name] = raw
        break
    return defaults


def parse_cmd_line(builddir: Path) -> set:
    path = builddir / 'meson-private' / 'cmd_line.txt'
    if not path.exists():
        return set()
    in_options = False
    names = set()
    for line in path.read_text().splitlines():
        line = line.strip()
        if line == '[options]':
            in_options = True
        elif line.startswith('['):
            in_options = False
        elif in_options and '=' in line:
            key = line.split('=')[0].strip()
            if ':' not in key:  # skip subproject options like foo:bar
                names.add(key)
    return names


def load_mesonferc_options(rc_path: Path) -> dict:
    if not rc_path.exists():
        return {}
    opts = {}
    in_options = False
    for line in rc_path.read_text().splitlines():
        line = line.strip()
        if line == '[options]':
            in_options = True
        elif line.startswith('['):
            in_options = False
        elif in_options and '=' in line and not line.startswith('#'):
            key, _, val = line.partition('=')
            opts[key.strip()] = val.strip()
    return opts


def save_mesonferc_options(rc_path: Path, options: dict):
    existing = rc_path.read_text().splitlines() if rc_path.exists() else []
    top_lines = []
    in_options = False
    for line in existing:
        stripped = line.strip()
        if stripped == '[options]':
            in_options = True
        elif stripped.startswith('['):
            in_options = False
            top_lines.append(line)
        elif not in_options:
            top_lines.append(line)
    while top_lines and not top_lines[-1].strip():
        top_lines.pop()
    lines = top_lines
    if options:
        if lines:
            lines.append('')
        lines.append('[options]')
        for key, val in options.items():
            lines.append(f'{key} = {val}')
    rc_path.write_text('\n'.join(lines) + '\n')


_RECENT_PATH = Path(user_config_dir('mesonfe')) / 'recent.json'
_RECENT_MAX = 10

_SHORTCUT_PATH = Path(user_config_dir('mesonfe')) / 'keybindings.json'

_DEFAULT_SHORTCUTS = {
    'file_open':         ('Open Build Directory…',   'Ctrl+O'),
    'file_quit':         ('Quit',                    'Ctrl+Q'),
    'build_save':        ('Save options to .mesonferc', 'Ctrl+S'),
    'build_setup':       ('Setup from .mesonferc',   'Ctrl+Shift+S'),
    'meson_compile':     ('Compile…',                'Ctrl+B'),
    'meson_install':     ('Install…',                'Ctrl+I'),
    'meson_dist':        ('Dist…',                   'Ctrl+D'),
    'meson_subprojects': ('Update Subprojects…',     'Ctrl+U'),
    'tests_display':     ('Display Tests…',          'Ctrl+T'),
    'help_about':        ('About',                   'F1'),
    'help_keybindings':  ('Configure Keybindings…',  'Ctrl+,'),
    'tools_open_terminal': ('Open Terminal…',         'Ctrl+Alt+T'),
    'view_toolbar':        ('Show Toolbar',           ''),
}


def load_shortcuts() -> dict:
    data = read_json(_SHORTCUT_PATH)
    if isinstance(data, dict):
        return data
    return {}


def save_shortcuts(shortcuts: dict):
    _SHORTCUT_PATH.parent.mkdir(parents=True, exist_ok=True)
    _SHORTCUT_PATH.write_text(json.dumps(shortcuts, indent=2))


def load_recent_dirs() -> list:
    data = read_json(_RECENT_PATH)
    if isinstance(data, list):
        return [p for p in data if Path(p).exists()]
    return []


def save_recent_dirs(dirs: list):
    _RECENT_PATH.parent.mkdir(parents=True, exist_ok=True)
    _RECENT_PATH.write_text(json.dumps(dirs, indent=2))


def add_recent_dir(builddir: Path) -> list:
    entry = str(builddir.resolve(strict=False))
    dirs = [d for d in load_recent_dirs() if d != entry]
    dirs.insert(0, entry)
    dirs = dirs[:_RECENT_MAX]
    save_recent_dirs(dirs)
    return dirs


class KeybindingsDialog(QDialog):
    def __init__(self, parent, action_map: dict):
        super().__init__(parent)
        self.setWindowTitle('Configure Keybindings')
        self.resize(480, 380)
        layout = QVBoxLayout(self)

        self._editors = {}
        tbl = QTableWidget(len(action_map), 2, self)
        tbl.setHorizontalHeaderLabels(['Action', 'Shortcut'])
        tbl.horizontalHeader().setSectionResizeMode(0, QHeaderView.Stretch)
        tbl.horizontalHeader().setSectionResizeMode(1, QHeaderView.ResizeToContents)
        tbl.verticalHeader().setVisible(False)
        tbl.setSelectionMode(QTableWidget.NoSelection)
        tbl.setEditTriggers(QTableWidget.NoEditTriggers)

        for row, (action_id, (name, action)) in enumerate(action_map.items()):
            item = QTableWidgetItem(name)
            item.setFlags(Qt.ItemIsEnabled)
            tbl.setItem(row, 0, item)
            editor = QKeySequenceEdit(action.shortcut())
            self._editors[action_id] = editor
            tbl.setCellWidget(row, 1, editor)

        tbl.resizeRowsToContents()
        layout.addWidget(tbl)

        btns = QHBoxLayout()
        reset_btn = QPushButton('Reset to Defaults')
        reset_btn.clicked.connect(self._reset)
        ok_btn = QPushButton('OK')
        ok_btn.clicked.connect(self.accept)
        cancel_btn = QPushButton('Cancel')
        cancel_btn.clicked.connect(self.reject)
        btns.addWidget(reset_btn)
        btns.addStretch()
        btns.addWidget(ok_btn)
        btns.addWidget(cancel_btn)
        layout.addLayout(btns)

    def _reset(self):
        for action_id, editor in self._editors.items():
            editor.setKeySequence(QKeySequence(_DEFAULT_SHORTCUTS[action_id][1]))

    def get_shortcuts(self) -> dict:
        return {aid: self._editors[aid].keySequence().toString()
                for aid in self._editors}


class MesonSetupDialog(QDialog):
    def __init__(self, parent: QWidget, args: list):
        super().__init__(parent)
        self.setWindowTitle('meson setup')
        self.resize(720, 480)
        layout = QVBoxLayout(self)
        self._out = QTextEdit()
        self._out.setReadOnly(True)
        self._out.setFont(QFont('monospace', 10))
        layout.addWidget(self._out)
        self._btn = QPushButton('Close')
        self._btn.setEnabled(False)
        self._btn.clicked.connect(self.accept)
        layout.addWidget(self._btn)
        self._proc = QProcess(self)
        self._proc.setProcessChannelMode(QProcess.MergedChannels)
        self._proc.readyRead.connect(
            lambda: self._append(bytes(self._proc.readAll()).decode(errors='replace'))
        )
        self._proc.finished.connect(self._on_finished)
        self._proc.start('meson', args)

    def _append(self, text: str):
        self._out.moveCursor(QTextCursor.End)
        self._out.insertPlainText(text)

    def _on_finished(self, code: int, _status):
        self._append(f'\n[exited {code}]')
        self._btn.setEnabled(True)

    def closeEvent(self, event):
        if self._proc.state() != QProcess.NotRunning:
            self._proc.kill()
            self._proc.waitForFinished(2000)
        super().closeEvent(event)


