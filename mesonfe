    @staticmethod
    def _make_reconfigure_icon(size: int = 16) -> QIcon:
        pix = QPixmap(size, size)
        pix.fill(Qt.transparent)
        painter = QPainter(pix)
        painter.setRenderHint(QPainter.Antialiasing)
        painter.setPen(Qt.NoPen)
        painter.setBrush(QColor('#2277bb'))
        painter.drawEllipse(0, 0, size, size)
        margin = max(2, size // 5)
        pen_w = max(1, size // 7)
        pen = QPen(QColor('white'), pen_w, Qt.SolidLine, Qt.RoundCap)
        painter.setPen(pen)
        painter.setBrush(Qt.NoBrush)
        painter.drawArc(margin, margin, size - 2 * margin, size - 2 * margin,
                        90 * 16, -270 * 16)
        # Arrowhead: at 9 o'clock, clockwise tangent is upward — "^" with tip at arc end
        cx = size // 2
        cy = size // 2
        r = (size - 2 * margin) // 2
        aw = max(2, size // 4)
        ex, ey = cx - r, cy
        painter.drawLine(ex, ey, ex - aw // 2, ey + aw // 2)
        painter.drawLine(ex, ey, ex + aw // 2, ey + aw // 2)
        painter.end()
        return QIcon(pix)

    @staticmethod
    def _make_remove_icon(size: int = 16) -> QIcon:
        pix = QPixmap(size, size)
        pix.fill(Qt.transparent)
        painter = QPainter(pix)
        painter.setRenderHint(QPainter.Antialiasing)
        painter.setPen(Qt.NoPen)
        painter.setBrush(QColor('#cc2222'))
        painter.drawEllipse(0, 0, size, size)
        pen = QPen(QColor('white'), max(2, size // 5), Qt.SolidLine, Qt.RoundCap)
        painter.setPen(pen)
        margin = size // 4
        mid = size // 2
        painter.drawLine(margin, mid, size - margin, mid)
        painter.end()
        return QIcon(pix)

    def _remove_builddir(self):
        builddir = self._builddir.resolve(strict=False)
        reply = QMessageBox.warning(
            self, 'Remove build directory',
            f'Permanently delete\n{builddir}\n\nThis cannot be undone. Continue?',
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No,
        )
        if reply != QMessageBox.Yes:
            return
        try:
            shutil.rmtree(builddir)
        except OSError as e:
            QMessageBox.critical(self, 'Error', f'Failed to remove build directory:\n{e}')
            return
        source_dir = self._source_dir
        self._builddir = None
        self._source_dir = None
        if self._project_dir is None and source_dir:
            self._project_dir = source_dir
        self._setup_panel.set_project_dir(self._project_dir or source_dir, force=True)
        self._setup_panel.set_build_src_dir(None)
        self.setWindowTitle(_make_window_title())
        self._status_label.setText(_('No build directory'))
        self._open_terminal_action.setEnabled(False)
        self._open_filemanager_action.setEnabled(False)
        self._reconfigure_action.setEnabled(False)
        self._wipe_action.setEnabled(False)
        self._remove_builddir_action.setEnabled(False)
        placeholder = QWidget()
        lbl = QLabel(_('No build directory loaded.\nOpen one via the File menu, or use the Setup tab to run meson setup.'))
        lbl.setAlignment(Qt.AlignCenter)
        QVBoxLayout(placeholder).addWidget(lbl)
        self._set_build_options_widget(placeholder)
        self._set_tabs_enabled(False)
        self._tabs.setCurrentWidget(self._setup_panel)

    def _refresh_recent_menu(self):
        self._recent_menu.clear()
        build_dirs = load_recent_dirs()
        project_dirs = load_recent_project_dirs()
        if not build_dirs and not project_dirs:
            empty = self._recent_menu.addAction('(empty)')
            empty.setEnabled(False)
            return
        self._recent_menu.addSection('Build Directories')
        if build_dirs:
            for path in build_dirs:
                action = self._recent_menu.addAction(path)
                action.triggered.connect(lambda checked, p=path: self._load_builddir(Path(p)))
        else:
            empty = self._recent_menu.addAction('(none)')
            empty.setEnabled(False)
        self._recent_menu.addSection('Project Directories')
        if project_dirs:
            for path in project_dirs:
                action = self._recent_menu.addAction(path)
                action.triggered.connect(lambda checked, p=path: self._open_recent_project_dir(Path(p)))
        else:
            empty = self._recent_menu.addAction('(none)')
            empty.setEnabled(False)
        self._recent_menu.addSeparator()
        self._recent_menu.addAction('Clear Recent').triggered.connect(self._clear_recent)

