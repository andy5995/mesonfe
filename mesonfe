        self._out.clear()
        self._line_buf[0] = ''
        self._run_btn.setEnabled(False)
        args = ['subprojects', 'update', '--sourcedir', str(self._source_dir)]
        if self._reset.isChecked():
            args.append('--reset')
        if self._allow_insecure.isChecked():
            args.append('--allow-insecure')
        if self._jobs.value() > 0:
            args += ['-j', str(self._jobs.value())]
        total = self._sp_list.count()
        selected = [self._sp_list.item(i).text() for i in range(total)
                    if self._sp_list.item(i).checkState() == Qt.Checked]
        if 0 < len(selected) < total:
            args.extend(selected)
        self._proc.start('meson', args)

    def _append(self, text: str):
        _append_highlighted(self._out, text, self._line_buf)

    def _on_finished(self, code: int, _status):
        self._append(f'\n[exited {code}]\n')
        self._run_btn.setEnabled(True)

