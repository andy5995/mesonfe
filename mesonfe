def _is_build_dir(path: Path) -> bool:
    return (path / 'meson-info').is_dir() or (path / 'meson-private').is_dir()


def find_builddir():
    if len(sys.argv) > 1:
        return Path(sys.argv[1])
    if _is_build_dir(Path('.')):
        return Path('.')
    for base in (Path('.'), Path('..')):
        rc = base / '.mesonferc'
        if rc.exists():
            for line in rc.read_text().splitlines():
                line = line.strip()
                if line.startswith('#') or '=' not in line:
                    continue
                key, _, val = line.partition('=')
                if key.strip() == 'default_builddir':
                    return base / val.strip().strip('"')
            return base / 'builddir'
    return None


def read_json(path: Path):
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def find_test_suites(builddir: Path) -> list:
    tests = read_json(builddir / 'meson-info' / 'intro-tests.json') or []
    seen = set()
    suites = []
    for t in tests:
        for s in t.get('suite', []):
            if s not in seen:
                seen.add(s)
                suites.append(s)
    return suites


def find_test_setups(builddir: Path) -> list:
    build_files = read_json(builddir / 'meson-info' / 'intro-buildsystem_files.json') or []
    setups = []
    for f in build_files:
        try:
            text = Path(f).read_text()
            setups.extend(re.findall(r"add_test_setup\s*\(\s*['\"]([^'\"]+)['\"]", text))
        except (OSError, UnicodeDecodeError):
            pass
    return setups


def load_project_data(builddir: Path):
    info_dir = builddir / 'meson-info'
    options = read_json(info_dir / 'intro-buildoptions.json') or []
    source_dir = None
    project_name = None
    info = read_json(info_dir / 'meson-info.json')
    if info:
        src = info.get('directories', {}).get('source')
        if src:
            source_dir = Path(src)
    proj = read_json(info_dir / 'intro-projectinfo.json')
    if proj:
        project_name = proj.get('descriptive_name')
    test_setups = find_test_setups(builddir)
    return options, test_setups, source_dir, project_name


def parse_defaults(source_dir: Path) -> dict:
    defaults = {}
    for fname in ('meson.options', 'meson_options.txt'):
        f = source_dir / fname
        if not f.exists():
            continue
        for m in re.finditer(r"option\s*\(\s*'([^']+)'([^)]*)\)", f.read_text(), re.DOTALL):
            name, body = m.group(1), m.group(2)
            vm = re.search(r"\bvalue\s*:\s*(['\"]?)([^,)'\"]+)\1", body)
            if not vm:
                continue
            raw = vm.group(2).strip()
            if raw == 'true':
                defaults[name] = True
            elif raw == 'false':
                defaults[name] = False
            elif re.fullmatch(r'-?\d+', raw):
                defaults[name] = int(raw)
            else:
                defaults[name] = raw
        break
    return defaults


def parse_cmd_line(builddir: Path) -> set:
    path = builddir / 'meson-private' / 'cmd_line.txt'
    if not path.exists():
        return set()
    in_options = False
    names = set()
    for line in path.read_text().splitlines():
        line = line.strip()
        if line == '[options]':
            in_options = True
        elif line.startswith('['):
            in_options = False
        elif in_options and '=' in line:
            key = line.split('=')[0].strip()
            if ':' not in key:  # skip subproject options like foo:bar
                names.add(key)
    return names


def load_mesonferc_options(rc_path: Path) -> dict:
    if not rc_path.exists():
        return {}
    opts = {}
    in_options = False
    for line in rc_path.read_text().splitlines():
        line = line.strip()
        if line == '[options]':
            in_options = True
        elif line.startswith('['):
            in_options = False
        elif in_options and '=' in line and not line.startswith('#'):
            key, _, val = line.partition('=')
            opts[key.strip()] = val.strip()
    return opts


def save_mesonferc_options(rc_path: Path, options: dict):
    existing = rc_path.read_text().splitlines() if rc_path.exists() else []
    top_lines = []
    in_options = False
    for line in existing:
        stripped = line.strip()
        if stripped == '[options]':
            in_options = True
        elif stripped.startswith('['):
            in_options = False
            top_lines.append(line)
        elif not in_options:
            top_lines.append(line)
    while top_lines and not top_lines[-1].strip():
        top_lines.pop()
    lines = top_lines
    if options:
        if lines:
            lines.append('')
        lines.append('[options]')
        for key, val in options.items():
            lines.append(f'{key} = {val}')
    rc_path.write_text('\n'.join(lines) + '\n')


