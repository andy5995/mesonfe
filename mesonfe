        self._proc.readyRead.connect(
            lambda: self._append(bytes(self._proc.readAll()).decode(errors='replace'))
        )
        self._proc.finished.connect(self._on_finished)
        self._line_buf = ['']


    def set_builddir(self, builddir):
        self._builddir = builddir

    def set_test_items(self, items):
        self._list.clear()
        for i, (label, args) in enumerate(items):
            item = QListWidgetItem(label)
            item.setCheckState(Qt.Checked if i == 0 else Qt.Unchecked)
            item.setData(Qt.UserRole, args)
            self._list.addItem(item)
        self._run_btn.setEnabled(bool(items) and self._builddir is not None)

    def _apply_mutual_exclusion(self, changed_item):
        self._changing = True
        default_item = self._list.item(0)
        if changed_item is default_item and changed_item.checkState() == Qt.Checked:
            for i in range(1, self._list.count()):
                self._list.item(i).setCheckState(Qt.Unchecked)
        elif changed_item is not default_item and changed_item.checkState() == Qt.Checked:
            default_item.setCheckState(Qt.Unchecked)
        self._changing = False

    def _on_item_changed(self, changed_item):
        if self._changing:
            return
        self._checkbox_just_clicked = True
        self._apply_mutual_exclusion(changed_item)

    def _toggle_item(self, item):
        if self._checkbox_just_clicked:
            self._checkbox_just_clicked = False
            return
        new_state = Qt.Unchecked if item.checkState() == Qt.Checked else Qt.Checked
        self._changing = True
        item.setCheckState(new_state)
        self._changing = False
        self._apply_mutual_exclusion(item)

    def _run(self):
        runs = [
            (self._list.item(i).text(), self._list.item(i).data(Qt.UserRole))
            for i in range(self._list.count())
            if self._list.item(i).checkState() == Qt.Checked
        ]
        if not runs:
            return
        if self._verbose.isChecked():
            runs = [(label, args + ['--verbose']) for label, args in runs]
        self._runs = runs
        self._run_idx = 0
        self._out.clear()
        self._line_buf[0] = ''
        self._run_btn.setEnabled(False)
        self._run_next()

    def _run_next(self):
        label, args = self._runs[self._run_idx]
        self._append(f'=== {label} ===\n')
        self._proc.start('meson', ['test', '-C', str(self._builddir)] + args)

    def _append(self, text: str):
        _append_highlighted(self._out, text, self._line_buf)

    def _on_finished(self, code: int, _status):
        self._append(f'[exited {code}]\n')
        self._run_idx += 1
        if self._run_idx < len(self._runs):
            self._append('\n')
            self._run_next()
        else:
            self._run_btn.setEnabled(True)

    def closeEvent(self, event):
        if self._proc.state() != QProcess.NotRunning:
            self._proc.kill()
            self._proc.waitForFinished(2000)
        super().closeEvent(event)



class ValueWidget(QWidget):
    def __init__(self, opt: dict):
        super().__init__()
        self._opt = opt
        layout = QHBoxLayout(self)
        layout.setContentsMargins(2, 1, 2, 1)
        layout.setSpacing(0)

        t, v = opt['type'], opt['value']

        if t == 'boolean':
            self._w = QComboBox()
            self._w.addItems(['true', 'false'])
            self._w.setCurrentText('true' if v else 'false')
        elif t in ('combo', 'feature'):
            self._w = QComboBox()
            choices = opt.get('choices') or (['enabled', 'disabled', 'auto'] if t == 'feature' else [])
            self._w.addItems([str(c) for c in choices])
            self._w.setCurrentText(str(v))
        elif t == 'array':
            self._w = QLineEdit(','.join(v) if isinstance(v, list) else str(v))
        else:
            self._w = QLineEdit(str(v))

        layout.addWidget(self._w)

    def current(self) -> str:
        return self._w.currentText() if isinstance(self._w, QComboBox) else self._w.text()

    def original(self) -> str:
        v = self._opt['value']
        if isinstance(v, bool):
            return 'true' if v else 'false'
        if isinstance(v, list):
            return ','.join(str(x) for x in v)
        return str(v)


class MesonHighlighter(QSyntaxHighlighter):
    _KEYWORDS = frozenset((
        'project', 'executable', 'library', 'shared_library', 'static_library',
        'both_libraries', 'shared_module', 'dependency', 'declare_dependency',
        'find_program', 'import', 'subdir', 'subproject', 'files', 'include_directories',
        'install_data', 'install_headers', 'install_man', 'install_subdir',
        'configure_file', 'custom_target', 'run_command', 'run_target',
        'test', 'benchmark', 'add_test_setup', 'add_project_arguments',
        'add_global_arguments', 'add_project_link_arguments',
        'get_option', 'option', 'message', 'warning', 'error', 'assert',
        'environment', 'generator', 'join_paths', 'build_target',
        'if', 'elif', 'else', 'endif', 'foreach', 'endforeach',
        'and', 'or', 'not', 'in', 'continue', 'break',
        'true', 'false',
    ))

    def __init__(self, document):
        super().__init__(document)

        def fmt(color, bold=False):
            f = QTextCharFormat()
            f.setForeground(QColor(color))
            if bold:
                f.setFontWeight(QFont.Bold)
            return f

        self._fmt_kw      = fmt('#569cd6', bold=True)
        self._fmt_str     = fmt('#ce9178')
        self._fmt_comment = fmt('#6a9955')
        self._fmt_num     = fmt('#b5cea8')
        self._fmt_func    = fmt('#dcdcaa')
        self._fmt_interp  = fmt('#4ec9b0')

        self._re_token = re.compile(
            r"'''|'|#|@\w+@|\b\d+(?:\.\d+)?\b|[A-Za-z_]\w*"
        )
        self._re_num   = re.compile(r'^\d')
        self._re_ident = re.compile(r'^[A-Za-z_]')

    def highlightBlock(self, text):
        in_triple = self.previousBlockState() == 1
        self.setCurrentBlockState(0)
        i = 0
        n = len(text)

        if in_triple:
            end = text.find("'''", i)
            if end == -1:
                self.setFormat(0, n, self._fmt_str)
                self.setCurrentBlockState(1)
                return
            self.setFormat(0, end + 3, self._fmt_str)
            i = end + 3

        while i < n:
            m = self._re_token.search(text, i)
            if not m:
                break
            s, tok = m.start(), m.group()

            if tok == "'''":
                end = text.find("'''", s + 3)
                if end == -1:
                    self.setFormat(s, n - s, self._fmt_str)
                    self.setCurrentBlockState(1)
                    return
                self.setFormat(s, end + 3 - s, self._fmt_str)
                i = end + 3

            elif tok == "'":
                j = s + 1
                while j < n:
                    if text[j] == '\\':
                        j += 2
                    elif text[j] == "'":
                        j += 1
                        break
                    else:
                        j += 1
                self.setFormat(s, j - s, self._fmt_str)
                i = j

            elif tok == '#':
                self.setFormat(s, n - s, self._fmt_comment)
                return

            elif tok.startswith('@'):
                self.setFormat(s, len(tok), self._fmt_interp)
                i = s + len(tok)

            elif self._re_num.match(tok):
                self.setFormat(s, len(tok), self._fmt_num)
                i = s + len(tok)

            else:
                # identifier — keyword, function call, or plain
                i = s + len(tok)
                if tok in self._KEYWORDS:
                    self.setFormat(s, len(tok), self._fmt_kw)
                elif i < n and text[i:].lstrip(' \t').startswith('('):
                    self.setFormat(s, len(tok), self._fmt_func)
                # else plain identifier, no colour


