    def _collect_options_to_save(self) -> dict:
        to_save = {}
        for opt, _ in self._changed:
            v = opt['value']
            to_save[opt['name']] = ','.join(str(x) for x in v) if isinstance(v, list) else str(v)
        for r in range(self._tbl.rowCount()):
            if self._tbl.isRowHidden(r):
                continue
            w = self._tbl.cellWidget(r, 2)
            if w.current() != w.original():
                to_save[self._options[r]['name']] = w.current()
        return to_save

    def _save_to_mesonferc(self):
        options = self._collect_options_to_save()
        if not options:
            QMessageBox.information(self, 'Nothing to save', 'No options differ from defaults.')
            return
        rc_path = self._source_dir / '.mesonferc'
        save_mesonferc_options(rc_path, options)
        self._setup_rc_action.setEnabled(True)
        QMessageBox.information(self, 'Saved', f'Saved {len(options)} option(s) to {rc_path.name}.')

    def _setup_from_mesonferc_file(self):
        source_dir = QFileDialog.getExistingDirectory(
            self, 'Select project directory containing .mesonferc'
        )
        if not source_dir:
            return
        source_dir = Path(source_dir)
        rc_path = source_dir / '.mesonferc'
        if not rc_path.exists():
            QMessageBox.warning(self, 'Not found',
                                f'No .mesonferc found in {source_dir}')
            return

        builddir_name = None
        for line in rc_path.read_text().splitlines():
            line = line.strip()
            if line.startswith('#') or '=' not in line:
                continue
            key, _, val = line.partition('=')
            if key.strip() == 'default_builddir':
                builddir_name = val.strip().strip('"')
                break

        if builddir_name:
            builddir = source_dir / builddir_name
        else:
            builddir_str = QFileDialog.getExistingDirectory(
                self, 'Select build directory', str(source_dir)
            )
            if not builddir_str:
                return
            builddir = Path(builddir_str)

        rc_options = load_mesonferc_options(rc_path)
        d_args = [f'-D{k}={v}' for k, v in rc_options.items()]
        has_build = (builddir / 'meson-info').exists()
        args = (['setup', str(source_dir), str(builddir)] +
                (['--reconfigure'] + d_args if has_build else d_args))
        dlg = MesonSetupDialog(self, args)
        dlg.exec_()
        if _is_build_dir(builddir):
            self._load_builddir(builddir)

    def _setup_from_mesonferc(self):
        rc_path = self._source_dir / '.mesonferc'
        rc_options = load_mesonferc_options(rc_path)
        if not rc_options:
            QMessageBox.information(self, 'No saved options', f'No [options] section found in {rc_path.name}.')
            return

        current_opts = self._collect_options_to_save()
        will_apply = [f'  -D{k}={v}' for k, v in rc_options.items()]
        will_reset = [
            f'  {k}={current_opts[k]}'
            for k in current_opts
            if k not in rc_options
        ]

        msg = 'Will apply:\n' + '\n'.join(will_apply)
        if will_reset:
            msg += '\n\nCurrently set but not in .mesonferc (will reset to default):\n' + '\n'.join(will_reset)
        msg += '\n\nContinue?'

        if QMessageBox.question(self, 'Setup from .mesonferc', msg) != QMessageBox.Yes:
            return

        d_args = [f'-D{k}={v}' for k, v in rc_options.items()]
        builddir = str(self._builddir.resolve(strict=False))
        has_build = (self._builddir / 'meson-info').exists()
        args = ['setup', str(self._source_dir), builddir] + (['--reconfigure'] + d_args if has_build else d_args)
        dlg = MesonSetupDialog(self, args)
        dlg.exec_()
        self._rebuild()

